# Ethereum mainnet application key. Keep this server-side.
ALCHEMY_API_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SIGNING_SECRET=
# Required for public production deployments; optional for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Maximum upstream requests per UTC day across all clients.
PROVIDER_DAILY_BUDGET=10000
